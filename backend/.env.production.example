NODE_ENV=production
PORT=3000
FRONTEND_URL=http://192.168.20.100

# Docker Compose necesita estos valores para inicializar mecaytro-postgres.
POSTGRES_DB=mecaytro
POSTGRES_USER=mecaytro_app
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_HEXADECIMAL_SEGURA

# Mantener la contraseña igual a POSTGRES_PASSWORD; codificarla en la URL si usa caracteres reservados.
DATABASE_URL=postgresql://mecaytro_app:CAMBIAR_POR_UNA_CLAVE_HEXADECIMAL_SEGURA@mecaytro-postgres:5432/mecaytro?schema=public
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
CLOUDINARY_CLOUD_NAME=CAMBIAR
CLOUDINARY_API_KEY=CAMBIAR
CLOUDINARY_API_SECRET=CAMBIAR