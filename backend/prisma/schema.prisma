generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int                   @id @default(autoincrement())
  nombre        String
  email         String                @unique
  password_hash String
  rol           String
  activo        Boolean               @default(true)
  cargo         String?
  permisos      String?
  personal_id   Int?                  @unique
  configuracion ConfiguracionUsuario?
  historial     HistorialCambios[]
  personal      Personal?             @relation(fields: [personal_id], references: [id])
}

model MateriaPrima {
  id                  Int                      @id @default(autoincrement())
  sku_mp              String                   @unique
  nombre_mp           String
  descripcion         String?
  categoria_mp        String
  unidad_medida_stock String
  stock_actual        Decimal                  @default(0)
  stock_reservado     Decimal                  @default(0)
  devoluciones        Decimal                  @default(0)
  punto_reorden       Decimal                  @default(0)
  costo_unitario      Decimal?                 @default(0)
  espesor             Decimal?                 @default(0)
  ancho               Decimal?                 @default(0)
  largo               Decimal?                 @default(0)
  densidad            Decimal?                 @default(7.85)
  peso_unitario       Decimal?                 @default(0)
  updatedAt           DateTime                 @default(now()) @updatedAt
  listaMateriales     ListaMateriales[]
  movimientos         MovimientoInventarioMP[]
  proveedores         MateriaPrimaProveedor[]
}

model Cliente {
  id                    Int                      @id @default(autoincrement())
  nombre                String                   @unique
  contacto              String?
  direccion             String?
  calificacion          Decimal?                 @default(0)
  activo                Boolean                  @default(true)
  movimientosInventario MovimientoInventarioMP[]
  productos             Producto[]
  reclamos              ReclamoCliente[]
  inspecciones          InspeccionCalidad[]
  noConformidades       NoConformidad[]
  riesgos               RiesgoCalidad[]
}

model Producto {
  id                Int                      @id @default(autoincrement())
  sku_producto      String                   @unique
  nombre_producto   String
  descripcion       String?
  cliente_id        Int?
  acabado           String?
  imagen_url        String?
  stock_actual      Int                      @default(0)
  stock_minimo      Int?
  stock_maximo      Int?
  ancho_tira        Decimal?
  medidas_pieza     String?
  piezas_lamina_4x8 String?
  piezas_lamina_2x1 String?
  empaque_de        String?
  ubicacion         String?
  plano_pdf_url     String?
  activo            Boolean                  @default(true)
  precio_venta      Decimal?                 @default(0)
  listaMateriales   ListaMateriales[]
  movimientos       MovimientoProducto[]
  ordenes           OrdenTrabajo[]
  pedidos           Pedido[]
  cliente           Cliente?                 @relation(fields: [cliente_id], references: [id])
  maquinasProcesos  ProductoMaquinaProceso[]
  rutas             RutaFabricacion[]
  planesControl     PlanControl[]
  inspecciones      InspeccionCalidad[]
  noConformidades   NoConformidad[]
  reclamos          ReclamoCliente[]
  riesgos           RiesgoCalidad[]
}

model ProductoMaquinaProceso {
  id              Int      @id @default(autoincrement())
  producto_id     Int
  maquina_id      Int
  proceso         String
  tiempo_estandar Decimal? @default(0)
  observaciones   String?
  maquina         Maquina  @relation(fields: [maquina_id], references: [id], onDelete: Cascade)
  producto        Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([producto_id, maquina_id, proceso])
}

model MovimientoProducto {
  id              Int      @id @default(autoincrement())
  producto_id     Int
  fecha           DateTime @default(now())
  tipo_movimiento String
  cantidad        Int
  referencia      String?
  producto        Producto @relation(fields: [producto_id], references: [id])
}

model ListaMateriales {
  id                 Int          @id @default(autoincrement())
  producto_id        Int
  materia_prima_id   Int
  cantidad_requerida Decimal
  materiaPrima       MateriaPrima @relation(fields: [materia_prima_id], references: [id])
  producto           Producto     @relation(fields: [producto_id], references: [id])
}

model RutaFabricacion {
  id                       Int               @id @default(autoincrement())
  producto_id              Int
  no_operacion             Int
  nombre_operacion         String
  centro_trabajo           String
  piezas_por_hora_estimado Int?
  tiempo_estandar          Decimal?
  activo                   Boolean           @default(true)
  producto                 Producto          @relation(fields: [producto_id], references: [id])
  tareas                   TareaProduccion[]
}

model Personal {
  id                    Int                     @id @default(autoincrement())
  nombre                String
  cedula                String                  @unique
  cargo                 String
  kpi_puntualidad       Float?
  salario               Decimal?                @default(0)
  calificacion          String?
  eficiencia            Float?
  productividad         Float?
  area                  String                  @default("")
  activo                Boolean                 @default(true)
  costo_hora_hombre     Decimal?                @default(0)
  prestaciones          Decimal?                @default(0)
  recargos              Decimal?                @default(0)
  dotaciones            DotacionEPP[]
  fasesProyecto         FaseProyecto[]
  prestamosHerramientas PrestamoHerramienta[]
  registrosTiempo       RegistroTiempoLaboral[]
  tareas                TareaProduccion[]
  usuario               Usuario?
  inspeccionesInspector InspeccionCalidad[]     @relation("InspectorRel")
  inspeccionesOperario  InspeccionCalidad[]     @relation("OperarioRel")
  noConformidades       NoConformidad[]
  accionesCorrectivas   AccionCorrectiva[]
  riesgosAsignados      RiesgoCalidad[]
}

model RegistroTiempoLaboral {
  id              Int      @id @default(autoincrement())
  personal_id     Int
  tipo            String
  fecha           DateTime
  horas           Float?   @default(0)
  horas_diurnas   Float?   @default(0)
  horas_nocturnas Float?   @default(0)
  horas_festivas  Float?   @default(0)
  costo_total     Decimal? @default(0)
  motivo          String?
  aprobado        Boolean  @default(false)
  pagado          Boolean  @default(false)
  fecha_creacion  DateTime @default(now())
  personal        Personal @relation(fields: [personal_id], references: [id])
}

model DotacionEPP {
  id            Int      @id @default(autoincrement())
  personal_id   Int
  item          String
  cantidad      Int
  fecha_entrega DateTime @default(now())
  comentarios   String?
  personal      Personal @relation(fields: [personal_id], references: [id])
}

model OrdenTrabajo {
  id                      Int                      @id @default(autoincrement())
  numero_ot               String                   @unique
  tipo_orden              String                   @default("PRODUCCION_SERIE")
  producto_id             Int?
  cantidad_pedido         Int                      @default(0)
  cantidad_fabricar       Int                      @default(0)
  descripcion_proyecto    String?
  cliente                 String?
  orden_compra_cliente    String?
  fecha_creacion          DateTime                 @default(now())
  fecha_entrega_req       DateTime?
  prioridad               String                   @default("ESTANDAR")
  estado_ot               String                   @default("Pendiente")
  acabado                 String?
  ancho_tira              Decimal?
  piezas_lamina           String?
  imagen_url              String?
  po_pdf_url              String?
  costo_total_estimado    Decimal?                 @default(0)
  costo_total_real        Decimal?                 @default(0)
  precio_venta            Decimal?                 @default(0)
  fecha_inicio_real       DateTime?
  fecha_fin_real          DateTime?
  duracion_total_real_min Int?                     @default(0)
  pedido_id               Int?
  proyecto_especial_id    Int?
  updatedAt               DateTime                 @default(now()) @updatedAt
  costo_herramientas      Decimal?                 @default(0)
  costo_mano_obra         Decimal?                 @default(0)
  costo_maquinaria        Decimal?                 @default(0)
  costo_materia_prima     Decimal?                 @default(0)
  costos_adicionales      Decimal?                 @default(0)
  costos_externos         Decimal?                 @default(0)
  maquina_id              Int?
  materialesProyecto      MaterialProyecto[]
  movimientosInventario   MovimientoInventarioMP[]
  maquina                 Maquina?                 @relation(fields: [maquina_id], references: [id])
  pedido                  Pedido?                  @relation(fields: [pedido_id], references: [id])
  producto                Producto?                @relation(fields: [producto_id], references: [id])
  proyectoEspecial        ProyectoEspecial?        @relation(fields: [proyecto_especial_id], references: [id], onDelete: SetNull)
  tareas                  TareaProduccion[]
  estado_calidad          String?                  @default("Pendiente")
  cantidad_aprobada       Int?                     @default(0)
  cantidad_rechazada      Int?                     @default(0)
  cantidad_retrabajada    Int?                     @default(0)
  materiales_consumidos   Boolean                  @default(false)
  fecha_consumo           DateTime?
  inspecciones            InspeccionCalidad[]
  noConformidades         NoConformidad[]
  reclamos                ReclamoCliente[]

  @@index([proyecto_especial_id])
}

model TareaProduccion {
  id                  Int              @id @default(autoincrement())
  orden_trabajo_id    Int
  ruta_fabricacion_id Int?
  personal_id         Int?
  maquina_id          Int?
  // Secuencia propia de la instancia de OT. No debe alterar la ruta maestra.
  secuencia_ot        Int?
  estado_tarea        String           @default("Pendiente")
  fecha_hora_inicio   DateTime?
  fecha_hora_fin      DateTime?
  tiempo_parada_min   Int              @default(0)
  cantidad_buena      Int?             @default(0)
  cantidad_mala       Int?             @default(0)
  motivo_rechazo      String?
  costo_estimado      Decimal?         @default(0)
  costo_real          Decimal?         @default(0)
  duracion_real_min   Int?             @default(0)
  updatedAt           DateTime         @updatedAt
  comentarios         String?
  fecha               DateTime?        @default(now())
  prioridad           String           @default("MEDIA")
  tiempo_estimado_min Int?             @default(0)
  tiempo_real_min     Int?             @default(0)
  maquina             Maquina?         @relation(fields: [maquina_id], references: [id])
  ordenTrabajo        OrdenTrabajo     @relation(fields: [orden_trabajo_id], references: [id])
  personal            Personal?        @relation(fields: [personal_id], references: [id])
  rutaFabricacion     RutaFabricacion? @relation(fields: [ruta_fabricacion_id], references: [id])
}

model MovimientoInventarioMP {
  id                  Int           @id @default(autoincrement())
  materia_prima_id    Int
  fecha_hora          DateTime      @default(now())
  tipo_movimiento     String
  cantidad            Decimal
  referencia_id       String?
  orden_trabajo_id    Int?
  imagen_remision_url String?
  cliente_id          Int?
  stock_anterior      Decimal?
  stock_posterior     Decimal?
  usuario_nombre      String?
  observacion         String?
  updatedAt           DateTime      @default(now()) @updatedAt
  cliente             Cliente?      @relation(fields: [cliente_id], references: [id])
  materiaPrima        MateriaPrima  @relation(fields: [materia_prima_id], references: [id])
  ordenTrabajo        OrdenTrabajo? @relation(fields: [orden_trabajo_id], references: [id])
}

model Maquina {
  id                       Int                       @id @default(autoincrement())
  codigo                   String                    @unique
  nombre                   String?
  area_produccion          String?
  tipo                     String?
  marca                    String?
  modelo                   String?
  serial                   String?
  fecha_compra             DateTime?
  estado                   String                    @default("Operativa")
  ubicacion                String?
  responsable              String?
  hoja_vida_url            String?
  foto_url                 String?
  adquirida_en             String?
  observaciones            String?
  motor_hp                 String?
  consumo_mes              String?
  capacidad_trabajo        String?
  horas_maquina_mes        String?
  horas_disponibles_semana Decimal?                  @default(40)
  costo_hora               Decimal?                  @default(0)
  depreciacion_anual       Decimal?                  @default(0)
  horas_acumuladas         Decimal?                  @default(0)
  tiempo_detenido_hrs      Decimal?                  @default(0)
  total_ordenes            Int                       @default(0)
  carga                    CargaMaquina[]
  consumibles              ConsumibleMaquina[]
  fasesProyecto            FaseProyecto[]
  mantenimientos           MantenimientoPreventivo[]
  ordenesMantenimiento     OrdenMantenimiento[]
  ordenesTrabajo           OrdenTrabajo[]
  planesMantenimiento      PlanMantenimiento[]
  productosProcesos        ProductoMaquinaProceso[]
  reportesFallas           ReporteFalla[]
  tareas                   TareaProduccion[]
  inspecciones             InspeccionCalidad[]
  noConformidades          NoConformidad[]
  riesgos                  RiesgoCalidad[]
}

model PlanMantenimiento {
  id                  Int                       @id @default(autoincrement())
  maquina_id          Int
  tarea               String
  tipo_mtto           String                    @default("Lubricación")
  frecuencia          String                    @default("Mensual")
  frecuencia_dias     Int                       @default(30)
  responsable         String
  checklist           String?
  tiempo_estimado_min Int?
  ultima_ejecucion    DateTime?
  proxima_fecha       DateTime?
  createdAt           DateTime                  @default(now())
  ejecuciones         MantenimientoPreventivo[]
  maquina             Maquina                   @relation(fields: [maquina_id], references: [id])
}

model MantenimientoPreventivo {
  id                   Int                 @id @default(autoincrement())
  maquina_id           Int
  plan_id              Int?
  fecha_programada     DateTime
  fecha_realizada      DateTime?
  tecnico_responsable  String?
  checklist_completado Boolean             @default(false)
  estado               String              @default("Programado")
  observaciones        String?
  foto_url             String?
  costo_mantenimiento  Decimal?            @default(0)
  createdAt            DateTime            @default(now())
  fotos                FotoMantenimiento[]
  maquina              Maquina             @relation(fields: [maquina_id], references: [id])
  plan                 PlanMantenimiento?  @relation(fields: [plan_id], references: [id])
}

model FotoMantenimiento {
  id               Int                     @id @default(autoincrement())
  mantenimiento_id Int
  url              String
  mantenimiento    MantenimientoPreventivo @relation(fields: [mantenimiento_id], references: [id])
}

model ReporteFalla {
  id                   Int                  @id @default(autoincrement())
  maquina_id           Int
  fecha_reporte        DateTime             @default(now())
  reportado_por        String
  descripcion          String
  prioridad            String               @default("Media")
  estado               String               @default("Pendiente")
  ordenesMantenimiento OrdenMantenimiento[]
  maquina              Maquina              @relation(fields: [maquina_id], references: [id])
}

model OrdenMantenimiento {
  id                Int           @id @default(autoincrement())
  maquina_id        Int
  falla_id          Int?
  tipo              String
  fecha_inicio      DateTime      @default(now())
  fecha_fin         DateTime?
  tecnico           String
  actividades       String?
  repuestos         String?
  tiempo_muerto_hrs Float?        @default(0)
  costo             Decimal?      @default(0)
  estado            String        @default("Abierta")
  createdAt         DateTime      @default(now())
  falla             ReporteFalla? @relation(fields: [falla_id], references: [id])
  maquina           Maquina       @relation(fields: [maquina_id], references: [id])
}

model ConsumibleMaquina {
  id                   Int       @id @default(autoincrement())
  maquina_id           Int
  nombre               String
  vida_util_dias       Int?
  cantidad_instalada   Decimal?
  fecha_ultimo_cambio  DateTime?
  fecha_proximo_cambio DateTime?
  createdAt            DateTime  @default(now())
  maquina              Maquina   @relation(fields: [maquina_id], references: [id])
}

model MaterialProyecto {
  id               Int          @id @default(autoincrement())
  orden_trabajo_id Int
  cantidad         Decimal
  unidad           String
  descripcion      String
  especificaciones String?
  ancho_tira       String?
  observaciones    String?
  ordenTrabajo     OrdenTrabajo @relation(fields: [orden_trabajo_id], references: [id])
}

model OperacionCatalog {
  id                          Int      @id @default(autoincrement())
  nombre_operacion            String
  centro_trabajo              String?
  orden                       Int      @default(0)
  costo_hora                  Decimal? @default(0)
  categoria_material_sugerido String?
}

model ProyectoEspecial {
  id                  Int                         @id @default(autoincrement())
  codigo              String                      @unique @default(cuid())
  cliente             String
  descripcion_tecnica String
  tipo_proyecto       String
  responsable_tecnico String
  fecha_inicio        DateTime
  fecha_compromiso    DateTime
  estado              String
  prioridad           String
  penalidad_retraso   String?
  porcentaje_avance   Float                       @default(0)
  indicador_riesgo    String                      @default("Bajo")
  bloqueado           Boolean                     @default(false)
  foto_referencia_url String?
  plano_pdf_url       String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  costo_estimado      Decimal?                    @default(0)
  costo_real          Decimal?                    @default(0)
  archivos            ArchivoAdjunto[]
  cargas_maquina      CargaMaquina[]
  fases               FaseProyecto[]
  historial           HistorialCambios[]
  materiales          MaterialRequeridoProyecto[]
  notas               NotaTecnica[]
  ordenes             OrdenTrabajo[]
  piezas              PiezaProyecto[]
}

model FaseProyecto {
  id              Int              @id @default(autoincrement())
  proyecto_id     Int
  nombre          String
  secuencia       Int              @default(10)
  responsable     String
  horas_estimadas Decimal
  horas_reales    Decimal?
  fecha_inicio    DateTime
  fecha_fin       DateTime?
  estado          String           @default("Pendiente")
  observaciones   String?
  maquina_id      Int?
  personal_id     Int?
  costo_operacion Decimal?         @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  maquina         Maquina?         @relation(fields: [maquina_id], references: [id])
  personal        Personal?        @relation(fields: [personal_id], references: [id])
  proyecto        ProyectoEspecial @relation(fields: [proyecto_id], references: [id])

  @@index([proyecto_id, secuencia])
}

model CargaMaquina {
  id              Int               @id @default(autoincrement())
  maquina_id      Int
  proyecto_id     Int?
  horas_asignadas Decimal
  semana          Int
  ano             Int
  maquina         Maquina           @relation(fields: [maquina_id], references: [id])
  proyecto        ProyectoEspecial? @relation(fields: [proyecto_id], references: [id])

  @@unique([maquina_id, semana, ano])
}

model HistorialCambios {
  id          Int              @id @default(autoincrement())
  proyecto_id Int
  usuario_id  Int
  fecha       DateTime         @default(now())
  descripcion String
  proyecto    ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
  usuario     Usuario          @relation(fields: [usuario_id], references: [id])
}

model ArchivoAdjunto {
  id             Int              @id @default(autoincrement())
  proyecto_id    Int
  nombre_archivo String
  url_archivo    String
  fecha_carga    DateTime         @default(now())
  proyecto       ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
}

model NotaTecnica {
  id          Int              @id @default(autoincrement())
  proyecto_id Int
  autor       String
  fecha       DateTime         @default(now())
  contenido   String
  proyecto    ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
}

model MaterialRequeridoProyecto {
  id            Int              @id @default(autoincrement())
  proyecto_id   Int
  descripcion   String
  tipo          String?
  cantidad      Decimal          @default(1)
  peso_kg       Decimal          @default(0)
  estado        String           @default("Pendiente")
  observaciones String?
  proyecto      ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
}

model PiezaProyecto {
  id                 Int              @id @default(autoincrement())
  proyecto_id        Int
  codigo             String?
  clave_idempotencia String?          @unique
  nombre             String
  cantidad           Int              @default(1)
  avance_fabricacion Float            @default(0)
  requiere_montaje   Boolean          @default(false)
  estado_montaje     String           @default("Pendiente")
  observaciones      String?
  plano_url_1        String?
  plano_url_2        String?
  tipo_material      String?
  largo              Decimal?
  ancho              Decimal?
  espesor            Decimal?
  diametro           Decimal?
  proyecto           ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
  registros          RegistroPieza[]

  @@unique([proyecto_id, codigo])
}

model RegistroPieza {
  id               Int           @id @default(autoincrement())
  pieza_id         Int
  tipo             String
  fecha            DateTime      @default(now())
  descripcion      String
  avance_reportado Float?
  cantidad_buena   Int           @default(0)
  cantidad_mala    Int           @default(0)
  cantidad_retrabajo Int         @default(0)
  clave_idempotencia String?     @unique
  pieza            PiezaProyecto @relation(fields: [pieza_id], references: [id])
}

model Alerta {
  id          Int      @id @default(autoincrement())
  tipo        String
  mensaje     String
  fecha       DateTime @default(now())
  leida       Boolean  @default(false)
  proyecto_id Int?
  maquina_id  Int?
}

model Configuracion {
  id                     Int      @id @default(autoincrement())
  max_proyectos_activos  Int      @default(10)
  nombre_empresa         String?  @default("MI EMPRESA SAS")
  nit_empresa            String?  @default("000.000.000-0")
  direccion_empresa      String?
  telefono_empresa       String?
  email_empresa          String?
  densidad_acero_default Decimal? @default(7.85)
  horas_turno_default    Decimal? @default(8)
  openrouter_api_key     String?
  openrouter_model       String?  @default("google/gemma-3-27b-it:free")
  unidad_longitud        String   @default("mm")
  unidad_peso            String   @default("kg")
  unidad_volumen         String   @default("litros")
  decimales_produccion   Int      @default(2)
  decimales_costos       Int      @default(2)
  decimales_medidas      Int      @default(2)
  umbral_stock_minimo    Decimal  @default(10)
  dias_retraso_alerta    Int      @default(1)
  frecuencia_alertas     String   @default("Inmediata")
  alarma_retraso_ot      Boolean  @default(true)
  alarma_bajo_stock      Boolean  @default(true)
  alarma_mantenimiento   Boolean  @default(true)
  alarma_fases_proyecto  Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model ConfiguracionUsuario {
  id                   Int     @id @default(autoincrement())
  usuario_id           Int     @unique
  tema                 String  @default("Automático")
  color_primario       String  @default("#2563eb")
  color_secundario     String  @default("#475569")
  color_superficie     String  @default("#ffffff")
  color_borde          String  @default("#e2e8f0")
  color_texto          String  @default("#0f172a")
  notificaciones_app   Boolean @default(true)
  notificaciones_email Boolean @default(false)
  usuario              Usuario @relation(fields: [usuario_id], references: [id])
}

model HerramientaConsumible {
  id                  Int                   @id @default(autoincrement())
  codigo              String?               @unique
  nombre              String
  tipo                String
  cantidad_total      Int                   @default(0)
  cantidad_disponible Int                   @default(0)
  estado              String                @default("DISPONIBLE")
  ubicacion           String?
  observaciones       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  costo_unitario      Decimal?              @default(0)
  prestamos           PrestamoHerramienta[]
}

model PrestamoHerramienta {
  id               Int                   @id @default(autoincrement())
  herramienta_id   Int
  personal_id      Int
  fecha_prestamo   DateTime              @default(now())
  fecha_devolucion DateTime?
  cantidad         Int                   @default(1)
  estado           String                @default("ACTIVO")
  observaciones    String?
  herramienta      HerramientaConsumible @relation(fields: [herramienta_id], references: [id])
  personal         Personal              @relation(fields: [personal_id], references: [id])
}

model Pedido {
  id                     Int            @id @default(autoincrement())
  cliente                String?
  orden_compra           String?
  fecha_emision          DateTime?
  codigo                 String?
  referencia             String?
  posicion               String?
  descripcion            String?
  cantidad               Int?           @default(0)
  cantidad_fabricada     Int?           @default(0)
  cantidad_en_inventario Int?           @default(0)
  cantidad_despachada    Int?           @default(0)
  saldo_pendiente        Int?           @default(0)
  fecha_entrega          String?
  estado                 String?        @default("PENDIENTE")
  precio_unitario        Decimal?       @default(0)
  valor_total            Decimal?       @default(0)
  producto_id            Int?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  ordenes                OrdenTrabajo[]
  producto               Producto?      @relation(fields: [producto_id], references: [id])
}

model Proveedor {
  id             Int                     @id @default(autoincrement())
  nombre         String                  @unique
  contacto       String?
  telefono       String?
  email          String?
  direccion      String?
  calificacion   Decimal?                @default(100)
  activo         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  inspecciones   InspeccionCalidad[]
  noConformidades NoConformidad[]
  materiasPrimas MateriaPrimaProveedor[]
  evaluaciones   EvaluacionProveedor[]
  riesgos        RiesgoCalidad[]
}

model MateriaPrimaProveedor {
  id               Int          @id @default(autoincrement())
  proveedor_id     Int
  materia_prima_id Int
  codigo_catalogo  String?
  precio_unitario  Decimal?
  lead_time_dias   Int?
  proveedor        Proveedor    @relation(fields: [proveedor_id], references: [id], onDelete: Cascade)
  materiaPrima     MateriaPrima @relation(fields: [materia_prima_id], references: [id], onDelete: Cascade)

  @@unique([proveedor_id, materia_prima_id])
}

model PlanControl {
  id              Int                     @id @default(autoincrement())
  producto_id     Int
  codigo          String                  @unique
  nombre          String
  version         String                  @default("1.0")
  activo          Boolean                 @default(true)
  notas           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  producto        Producto                @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  caracteristicas CaracteristicaControl[]
  inspecciones    InspeccionCalidad[]
}

model CaracteristicaControl {
  id                  Int                  @id @default(autoincrement())
  plan_control_id     Int
  secuencia           Int                  @default(10)
  caracteristica      String
  cota_nominal        Decimal?
  tolerancia_min      Decimal?
  tolerancia_max      Decimal?
  unidad              String               @default("mm")
  instrumento         String
  metodo_medicion     String?
  frecuencia          String               @default("100%")
  criterio_aceptacion String
  es_critica          Boolean              @default(false)
  planControl         PlanControl          @relation(fields: [plan_control_id], references: [id], onDelete: Cascade)
  mediciones          MedicionInspeccion[]
}

model InspeccionCalidad {
  id                     Int                  @id @default(autoincrement())
  codigo                 String               @unique
  tipo                   String               // RECEPCION, EN_PROCESO, FINAL, DESPACHO, ESPECIAL
  orden_trabajo_id       Int?
  producto_id            Int?
  proveedor_id           Int?
  cliente_id             Int?
  maquina_id             Int?
  personal_id            Int?                 // Inspector
  operario_id            Int?                 // Operario
  plan_control_id        Int?
  lote                   String?
  fecha_inspeccion       DateTime             @default(now())
  cantidad_inspeccionada Int                  @default(0)
  cantidad_aprobada      Int                  @default(0)
  cantidad_rechazada     Int                  @default(0)
  estado_resultado       String               @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO, RETENIDO, CONDICIONAL
  observaciones          String?
  evidencias_url         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  mediciones             MedicionInspeccion[]
  noConformidades        NoConformidad[]
  cliente                Cliente?             @relation(fields: [cliente_id], references: [id])
  maquina                Maquina?             @relation(fields: [maquina_id], references: [id])
  ordenTrabajo           OrdenTrabajo?        @relation(fields: [orden_trabajo_id], references: [id])
  inspector              Personal?            @relation("InspectorRel", fields: [personal_id], references: [id])
  operario               Personal?            @relation("OperarioRel", fields: [operario_id], references: [id])
  planControl            PlanControl?         @relation(fields: [plan_control_id], references: [id])
  producto               Producto?            @relation(fields: [producto_id], references: [id])
  proveedor              Proveedor?           @relation(fields: [proveedor_id], references: [id])
}

model MedicionInspeccion {
  id                    Int                    @id @default(autoincrement())
  inspeccion_id         Int
  caracteristica_id     Int?
  nombre_caracteristica String
  especificacion        String?
  cota_nominal          Decimal?
  tolerancia_min        Decimal?
  tolerancia_max        Decimal?
  instrumento           String?
  valores_medidos       String                 // JSON Array
  promedio              Decimal?
  minimo                Decimal?
  maximo                Decimal?
  rango                 Decimal?
  desviacion            Decimal?
  cumple                Boolean                @default(true)
  observacion           String?
  caracteristica        CaracteristicaControl? @relation(fields: [caracteristica_id], references: [id])
  inspeccion            InspeccionCalidad      @relation(fields: [inspeccion_id], references: [id], onDelete: Cascade)
}

model NoConformidad {
  id                      Int                 @id @default(autoincrement())
  codigo                  String              @unique
  fecha                   DateTime            @default(now())
  origen                  String              // INSPECCION, PRODUCCION, CLIENTE, PROVEEDOR, MATERIA_PRIMA, MANTENIMIENTO, AUDITORIA, RECLAMO, INTERNO
  tipo_defecto            String              // DIMENSIONAL, VISUAL, MATERIAL, SOLDADURA, RUGOSIDAD, ACABADO, FUNCIONAL, DOCUMENTAL, MONTAJE, DANO, OTRO
  descripcion             String
  cantidad_afectada       Int                 @default(1)
  costo_estimado          Decimal?            @default(0)
  estado                  String              @default("ABIERTA") // ABIERTA, EN_ANALISIS, EN_ACCION, VERIFICADA, CERRADA, ANULADA
  disposicion             String?             // RETRABAJO, REPARACION, RECLASIFICACION, DEVOLUCION_PROVEEDOR, DESCARTE, CONCESION
  autorizado_por          String?
  justificacion_concesion String?
  evidencias_url          String?
  fecha_limite            DateTime?
  fecha_cierre            DateTime?
  orden_trabajo_id        Int?
  producto_id             Int?
  inspeccion_id           Int?
  cliente_id              Int?
  proveedor_id            Int?
  maquina_id              Int?
  personal_id             Int?                // Responsable
  reclamo_id              Int?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  accionesCorrectivas     AccionCorrectiva[]
  analisisCausa           AnalisisCausaNC?
  cliente                 Cliente?            @relation(fields: [cliente_id], references: [id])
  inspeccion              InspeccionCalidad?  @relation(fields: [inspeccion_id], references: [id])
  maquina                 Maquina?            @relation(fields: [maquina_id], references: [id])
  ordenTrabajo            OrdenTrabajo?       @relation(fields: [orden_trabajo_id], references: [id])
  responsable             Personal?           @relation(fields: [personal_id], references: [id])
  producto                Producto?           @relation(fields: [producto_id], references: [id])
  proveedor               Proveedor?          @relation(fields: [proveedor_id], references: [id])
  reclamoCliente          ReclamoCliente?     @relation(fields: [reclamo_id], references: [id])
}

model AnalisisCausaNC {
  id                      Int           @id @default(autoincrement())
  no_conformidad_id       Int           @unique
  metodo_analisis         String        @default("AMBOS")
  porque_1                String?
  porque_2                String?
  porque_3                String?
  porque_4                String?
  porque_5                String?
  causa_raiz              String?
  ishikawa_maquina        String?
  ishikawa_metodo         String?
  ishikawa_mano_obra      String?
  ishikawa_material       String?
  ishikawa_medicion       String?
  ishikawa_medio_ambiente String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  noConformidad           NoConformidad @relation(fields: [no_conformidad_id], references: [id], onDelete: Cascade)
}

model AccionCorrectiva {
  id                         Int            @id @default(autoincrement())
  codigo                     String         @unique
  no_conformidad_id          Int?
  tipo                       String         @default("CORRECTIVA") // CORRECTIVA, PREVENTIVA, MEJORA
  titulo                     String
  descripcion_problema       String
  causa_raiz                 String?
  accion_propuesta           String
  personal_id                Int?
  fecha_limite               DateTime
  fecha_implementacion       DateTime?
  fecha_verificacion         DateTime?
  estado                     String         @default("ABIERTA") // ABIERTA, EN_PROCESO, PENDIENTE_VERIFICACION, EFICAZ, NO_EFICAZ, CERRADA
  eficacia_evaluada          Boolean?
  evidencias_url             String?
  observaciones_verificacion String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  noConformidad              NoConformidad? @relation(fields: [no_conformidad_id], references: [id])
  responsable                Personal?      @relation(fields: [personal_id], references: [id])
}

model RiesgoCalidad {
  id           Int        @id @default(autoincrement())
  codigo       String     @unique
  tipo         String     @default("RIESGO") // RIESGO, OPORTUNIDAD
  proceso      String
  descripcion  String
  causa        String?
  consecuencia String?
  probabilidad Int        @default(1)
  impacto      Int        @default(1)
  nivel_riesgo Int        @default(1)
  estrategia   String?
  plan_accion  String?
  personal_id  Int?
  estado       String     @default("IDENTIFICADO")
  maquina_id   Int?
  producto_id  Int?
  proveedor_id Int?
  cliente_id   Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cliente      Cliente?   @relation(fields: [cliente_id], references: [id])
  maquina      Maquina?   @relation(fields: [maquina_id], references: [id])
  responsable  Personal?  @relation(fields: [personal_id], references: [id])
  producto     Producto?  @relation(fields: [producto_id], references: [id])
  proveedor    Proveedor? @relation(fields: [proveedor_id], references: [id])
}

model ReclamoCliente {
  id                  Int             @id @default(autoincrement())
  codigo              String          @unique
  cliente_id          Int
  producto_id         Int?
  orden_trabajo_id    Int?
  fecha_reclamo       DateTime        @default(now())
  motivo              String
  descripcion         String
  es_devolucion       Boolean         @default(false)
  cantidad_afectada   Int             @default(0)
  costo_estimado      Decimal?        @default(0)
  accion_inmediata    String?
  estado              String          @default("ABIERTO")
  satisfaccion_cierre String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  noConformidades     NoConformidad[]
  cliente             Cliente         @relation(fields: [cliente_id], references: [id])
  ordenTrabajo        OrdenTrabajo?   @relation(fields: [orden_trabajo_id], references: [id])
  producto            Producto?       @relation(fields: [producto_id], references: [id])
}

model AuditoriaCalidad {
  id               Int                 @id @default(autoincrement())
  codigo           String              @unique
  tipo             String              // INTERNA, EXTERNA, PROVEEDOR, PROCESO
  titulo           String
  proceso_area     String
  auditor_lider    String
  equipo_auditor   String?
  fecha_programada DateTime
  fecha_ejecucion  DateTime?
  estado           String              @default("PROGRAMADA")
  objetivo         String?
  alcance          String?
  criterios        String?
  conclusiones     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  hallazgos        HallazgoAuditoria[]
}

model HallazgoAuditoria {
  id            Int              @id @default(autoincrement())
  auditoria_id  Int
  tipo_hallazgo String           // NO_CONFORMIDAD_MAYOR, NO_CONFORMIDAD_MENOR, OPORTUNIDAD_MEJORA, FORTALEZA
  descripcion   String
  clausula_iso  String?
  evidencia     String?
  auditoria     AuditoriaCalidad @relation(fields: [auditoria_id], references: [id], onDelete: Cascade)
}

model DocumentoSGC {
  id                Int                         @id @default(autoincrement())
  codigo            String                      @unique
  nombre            String
  tipo              String                      // MANUAL, POLITICA, PROCEDIMIENTO, INSTRUCTIVO, FORMATO, PLAN, REGISTRO
  proceso           String
  version_actual    String                      @default("1.0")
  estado            String                      @default("VIGENTE") // VIGENTE, EN_REVISION, OBSOLETO
  responsable       String
  fecha_aprobacion  DateTime                    @default(now())
  fecha_proxima_rev DateTime?
  archivo_url       String?
  descripcion       String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  versiones         HistorialVersionDocumento[]
}

model HistorialVersionDocumento {
  id               Int          @id @default(autoincrement())
  documento_id     Int
  version          String
  fecha            DateTime     @default(now())
  usuario_nombre   String
  cambio_realizado String
  motivo_cambio    String
  archivo_url      String?
  documento        DocumentoSGC @relation(fields: [documento_id], references: [id], onDelete: Cascade)
}

model AuditoriaRegistroCalidad {
  id             Int      @id @default(autoincrement())
  usuario_id     Int?
  usuario_nombre String
  accion         String   // APROBACION_OT, RECHAZO_OT, LIBERACION, CONCESION, CIERRE_NC, CREACION_INSPECCION
  modulo         String   // CALIDAD, PRODUCCION, FINANZAS
  entidad        String   // OrdenTrabajo, InspeccionCalidad, NoConformidad, DocumentoSGC
  entidad_id     Int
  valor_anterior String?
  valor_nuevo    String?
  detalles       String?
  ip_origen      String?
  fecha          DateTime @default(now())
}

model EvaluacionProveedor {
  id                Int       @id @default(autoincrement())
  proveedor_id      Int
  periodo           String
  indice_calidad    Decimal   @default(100)
  entregas_a_tiempo Decimal?  @default(100)
  total_recepciones Int       @default(0)
  total_rechazos    Int       @default(0)
  total_nc          Int       @default(0)
  estado_aprobacion String    @default("APROBADO")
  observaciones     String?
  evaluador         String?
  createdAt         DateTime  @default(now())
  proveedor         Proveedor @relation(fields: [proveedor_id], references: [id], onDelete: Cascade)
}
