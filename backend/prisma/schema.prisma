generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int                   @id @default(autoincrement())
  nombre        String
  email         String                @unique
  password_hash String
  rol           String
  configuracion ConfiguracionUsuario?
  historial     HistorialCambios[]
}

model MateriaPrima {
  id                  Int                      @id @default(autoincrement())
  sku_mp              String                   @unique
  nombre_mp           String
  descripcion         String?
  categoria_mp        String
  unidad_medida_stock String
  stock_actual        Decimal                  @default(0)
  stock_reservado     Decimal                  @default(0)
  devoluciones        Decimal                  @default(0)
  punto_reorden       Decimal                  @default(0)
  costo_unitario      Decimal?                 @default(0)
  espesor             Decimal?                 @default(0)
  ancho               Decimal?                 @default(0)
  largo               Decimal?                 @default(0)
  densidad            Decimal?                 @default(7.85)
  peso_unitario       Decimal?                 @default(0)
  updatedAt           DateTime                 @default(now()) @updatedAt
  listaMateriales     ListaMateriales[]
  movimientos         MovimientoInventarioMP[]
}

model Cliente {
  id                    Int                      @id @default(autoincrement())
  nombre                String                   @unique
  contacto              String?
  direccion             String?
  calificacion          Decimal?                 @default(0)
  movimientosInventario MovimientoInventarioMP[]
  productos             Producto[]
}

model Producto {
  id                Int                  @id @default(autoincrement())
  sku_producto      String               @unique
  nombre_producto   String
  descripcion       String?
  cliente_id        Int?
  acabado           String?
  imagen_url        String?
  stock_actual      Int                  @default(0)
  ancho_tira        Decimal?
  medidas_pieza     String?
  piezas_lamina_4x8 String?
  piezas_lamina_2x1 String?
  empaque_de        String?
  ubicacion         String?
  plano_pdf_url     String?
  activo            Boolean              @default(true)
  precio_venta      Decimal?             @default(0)
  listaMateriales   ListaMateriales[]
  movimientos       MovimientoProducto[]
  ordenes           OrdenTrabajo[]
  pedidos           Pedido[]
  cliente           Cliente?             @relation(fields: [cliente_id], references: [id])
  rutas             RutaFabricacion[]
}

model MovimientoProducto {
  id              Int      @id @default(autoincrement())
  producto_id     Int
  fecha           DateTime @default(now())
  tipo_movimiento String
  cantidad        Int
  referencia      String?
  producto        Producto @relation(fields: [producto_id], references: [id])
}

model ListaMateriales {
  id                 Int          @id @default(autoincrement())
  producto_id        Int
  materia_prima_id   Int
  cantidad_requerida Decimal
  materiaPrima       MateriaPrima @relation(fields: [materia_prima_id], references: [id])
  producto           Producto     @relation(fields: [producto_id], references: [id])
}

model RutaFabricacion {
  id                       Int               @id @default(autoincrement())
  producto_id              Int
  no_operacion             Int
  nombre_operacion         String
  centro_trabajo           String
  piezas_por_hora_estimado Int?
  tiempo_estandar          Decimal?
  activo                   Boolean           @default(true)
  producto                 Producto          @relation(fields: [producto_id], references: [id])
  tareas                   TareaProduccion[]
}

model Personal {
  id                    Int                     @id @default(autoincrement())
  nombre                String
  cedula                String                  @unique
  cargo                 String
  kpi_puntualidad       Float?
  salario               Decimal?
  calificacion          String?
  eficiencia            Float?
  productividad         Float?
  area                  String                  @default("")
  activo                Boolean                 @default(true)
  dotaciones            DotacionEPP[]
  fasesProyecto         FaseProyecto[]
  prestamosHerramientas PrestamoHerramienta[]
  registrosTiempo       RegistroTiempoLaboral[]
  tareas                TareaProduccion[]
}

model RegistroTiempoLaboral {
  id              Int      @id @default(autoincrement())
  personal_id     Int
  tipo            String
  fecha           DateTime
  horas           Float?   @default(0)
  horas_diurnas   Float?   @default(0)
  horas_nocturnas Float?   @default(0)
  horas_festivas  Float?   @default(0)
  costo_total     Decimal? @default(0)
  motivo          String?
  aprobado        Boolean  @default(false)
  pagado          Boolean  @default(false)
  fecha_creacion  DateTime @default(now())
  personal        Personal @relation(fields: [personal_id], references: [id])
}

model DotacionEPP {
  id            Int      @id @default(autoincrement())
  personal_id   Int
  item          String
  cantidad      Int
  fecha_entrega DateTime @default(now())
  comentarios   String?
  personal      Personal @relation(fields: [personal_id], references: [id])
}

model OrdenTrabajo {
  id                      Int                      @id @default(autoincrement())
  numero_ot               String                   @unique
  tipo_orden              String                   @default("PRODUCCION_SERIE")
  producto_id             Int?
  cantidad_pedido         Int                      @default(0)
  cantidad_fabricar       Int                      @default(0)
  descripcion_proyecto    String?
  cliente                 String?
  orden_compra_cliente    String?
  fecha_creacion          DateTime                 @default(now())
  fecha_entrega_req       DateTime?
  prioridad               String                   @default("ESTANDAR")
  estado_ot               String                   @default("Pendiente")
  acabado                 String?
  ancho_tira              Decimal?
  piezas_lamina           String?
  imagen_url              String?
  po_pdf_url              String?
  costo_total_estimado    Decimal?                 @default(0)
  costo_total_real        Decimal?                 @default(0)
  precio_venta            Decimal?                 @default(0)
  fecha_inicio_real       DateTime?
  fecha_fin_real          DateTime?
  duracion_total_real_min Int?                     @default(0)
  pedido_id               Int?
  updatedAt               DateTime                 @default(now()) @updatedAt
  materialesProyecto      MaterialProyecto[]
  movimientosInventario   MovimientoInventarioMP[]
  pedido                  Pedido?                  @relation(fields: [pedido_id], references: [id])
  producto                Producto?                @relation(fields: [producto_id], references: [id])
  tareas                  TareaProduccion[]
}

model TareaProduccion {
  id                  Int             @id @default(autoincrement())
  orden_trabajo_id    Int
  ruta_fabricacion_id Int
  personal_id         Int?
  maquina_id          Int?
  estado_tarea        String          @default("Pendiente")
  fecha_hora_inicio   DateTime?
  fecha_hora_fin      DateTime?
  tiempo_parada_min   Int             @default(0)
  cantidad_buena      Int?            @default(0)
  cantidad_mala       Int?            @default(0)
  motivo_rechazo      String?
  costo_estimado      Decimal?        @default(0)
  costo_real          Decimal?        @default(0)
  duracion_real_min   Int?            @default(0)
  updatedAt           DateTime        @default(now()) @updatedAt
  maquina             Maquina?        @relation(fields: [maquina_id], references: [id])
  ordenTrabajo        OrdenTrabajo    @relation(fields: [orden_trabajo_id], references: [id])
  personal            Personal?       @relation(fields: [personal_id], references: [id])
  rutaFabricacion     RutaFabricacion @relation(fields: [ruta_fabricacion_id], references: [id])
}

model MovimientoInventarioMP {
  id                  Int           @id @default(autoincrement())
  materia_prima_id    Int
  fecha_hora          DateTime      @default(now())
  tipo_movimiento     String
  cantidad            Decimal
  referencia_id       String?
  orden_trabajo_id    Int?
  imagen_remision_url String?
  cliente_id          Int?
  updatedAt           DateTime      @default(now()) @updatedAt
  cliente             Cliente?      @relation(fields: [cliente_id], references: [id])
  materiaPrima        MateriaPrima  @relation(fields: [materia_prima_id], references: [id])
  ordenTrabajo        OrdenTrabajo? @relation(fields: [orden_trabajo_id], references: [id])
}

model Maquina {
  id                       Int                       @id @default(autoincrement())
  codigo                   String                    @unique
  nombre                   String?
  area_produccion          String?
  tipo                     String?
  marca                    String?
  modelo                   String?
  serial                   String?
  fecha_compra             DateTime?
  estado                   String                    @default("Operativa")
  ubicacion                String?
  responsable              String?
  hoja_vida_url            String?
  foto_url                 String?
  adquirida_en             String?
  observaciones            String?
  motor_hp                 String?
  consumo_mes              String?
  capacidad_trabajo        String?
  horas_maquina_mes        String?
  horas_disponibles_semana Decimal?                  @default(40)
  carga                    CargaMaquina[]
  consumibles              ConsumibleMaquina[]
  fasesProyecto            FaseProyecto[]
  mantenimientos           MantenimientoPreventivo[]
  ordenesMantenimiento     OrdenMantenimiento[]
  planesMantenimiento      PlanMantenimiento[]
  reportesFallas           ReporteFalla[]
  tareas                   TareaProduccion[]
}

model PlanMantenimiento {
  id                  Int                       @id @default(autoincrement())
  maquina_id          Int
  tarea               String
  tipo_mtto           String                    @default("Lubricación")
  frecuencia          String                    @default("Mensual")
  frecuencia_dias     Int                       @default(30)
  responsable         String
  checklist           String?
  tiempo_estimado_min Int?
  ultima_ejecucion    DateTime?
  proxima_fecha       DateTime?
  createdAt           DateTime                  @default(now())
  ejecuciones         MantenimientoPreventivo[]
  maquina             Maquina                   @relation(fields: [maquina_id], references: [id])
}

model MantenimientoPreventivo {
  id                   Int                 @id @default(autoincrement())
  maquina_id           Int
  plan_id              Int?
  fecha_programada     DateTime
  fecha_realizada      DateTime?
  tecnico_responsable  String?
  checklist_completado Boolean             @default(false)
  estado               String              @default("Programado")
  observaciones        String?
  foto_url             String?
  costo_mantenimiento  Decimal?            @default(0)
  createdAt            DateTime            @default(now())
  fotos                FotoMantenimiento[]
  maquina              Maquina             @relation(fields: [maquina_id], references: [id])
  plan                 PlanMantenimiento?  @relation(fields: [plan_id], references: [id])
}

model FotoMantenimiento {
  id               Int                     @id @default(autoincrement())
  mantenimiento_id Int
  url              String
  mantenimiento    MantenimientoPreventivo @relation(fields: [mantenimiento_id], references: [id])
}

model ReporteFalla {
  id                   Int                  @id @default(autoincrement())
  maquina_id           Int
  fecha_reporte        DateTime             @default(now())
  reportado_por        String
  descripcion          String
  prioridad            String               @default("Media")
  estado               String               @default("Pendiente")
  ordenesMantenimiento OrdenMantenimiento[]
  maquina              Maquina              @relation(fields: [maquina_id], references: [id])
}

model OrdenMantenimiento {
  id                Int           @id @default(autoincrement())
  maquina_id        Int
  falla_id          Int?
  tipo              String
  fecha_inicio      DateTime      @default(now())
  fecha_fin         DateTime?
  tecnico           String
  actividades       String?
  repuestos         String?
  tiempo_muerto_hrs Float?        @default(0)
  costo             Decimal?      @default(0)
  estado            String        @default("Abierta")
  createdAt         DateTime      @default(now())
  falla             ReporteFalla? @relation(fields: [falla_id], references: [id])
  maquina           Maquina       @relation(fields: [maquina_id], references: [id])
}

model ConsumibleMaquina {
  id                   Int       @id @default(autoincrement())
  maquina_id           Int
  nombre               String
  vida_util_dias       Int?
  cantidad_instalada   Decimal?
  fecha_ultimo_cambio  DateTime?
  fecha_proximo_cambio DateTime?
  createdAt            DateTime  @default(now())
  maquina              Maquina   @relation(fields: [maquina_id], references: [id])
}

model MaterialProyecto {
  id               Int          @id @default(autoincrement())
  orden_trabajo_id Int
  cantidad         Decimal
  unidad           String
  descripcion      String
  especificaciones String?
  ancho_tira       String?
  observaciones    String?
  ordenTrabajo     OrdenTrabajo @relation(fields: [orden_trabajo_id], references: [id])
}

model OperacionCatalog {
  id                          Int      @id @default(autoincrement())
  nombre_operacion            String
  centro_trabajo              String?
  orden                       Int      @default(0)
  costo_hora                  Decimal? @default(0)
  categoria_material_sugerido String?
}

model ProyectoEspecial {
  id                  Int                         @id @default(autoincrement())
  codigo              String                      @unique @default(cuid())
  cliente             String
  descripcion_tecnica String
  tipo_proyecto       String
  responsable_tecnico String
  fecha_inicio        DateTime
  fecha_compromiso    DateTime
  estado              String
  prioridad           String
  penalidad_retraso   String?
  porcentaje_avance   Float                       @default(0)
  indicador_riesgo    String                      @default("Bajo")
  bloqueado           Boolean                     @default(false)
  foto_referencia_url String?
  plano_pdf_url       String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  archivos            ArchivoAdjunto[]
  cargas_maquina      CargaMaquina[]
  fases               FaseProyecto[]
  historial           HistorialCambios[]
  materiales          MaterialRequeridoProyecto[]
  notas               NotaTecnica[]
  piezas              PiezaProyecto[]
}

model FaseProyecto {
  id              Int              @id @default(autoincrement())
  proyecto_id     Int
  nombre          String
  responsable     String
  horas_estimadas Decimal
  horas_reales    Decimal?
  fecha_inicio    DateTime
  fecha_fin       DateTime?
  estado          String           @default("Pendiente")
  observaciones   String?
  maquina_id      Int?
  personal_id     Int?
  costo_operacion Decimal?         @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  maquina         Maquina?         @relation(fields: [maquina_id], references: [id])
  personal        Personal?        @relation(fields: [personal_id], references: [id])
  proyecto        ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
}

model CargaMaquina {
  id              Int               @id @default(autoincrement())
  maquina_id      Int
  proyecto_id     Int?
  horas_asignadas Decimal
  semana          Int
  ano             Int
  maquina         Maquina           @relation(fields: [maquina_id], references: [id])
  proyecto        ProyectoEspecial? @relation(fields: [proyecto_id], references: [id])

  @@unique([maquina_id, semana, ano])
}

model HistorialCambios {
  id          Int              @id @default(autoincrement())
  proyecto_id Int
  usuario_id  Int
  fecha       DateTime         @default(now())
  descripcion String
  proyecto    ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
  usuario     Usuario          @relation(fields: [usuario_id], references: [id])
}

model ArchivoAdjunto {
  id             Int              @id @default(autoincrement())
  proyecto_id    Int
  nombre_archivo String
  url_archivo    String
  fecha_carga    DateTime         @default(now())
  proyecto       ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
}

model NotaTecnica {
  id          Int              @id @default(autoincrement())
  proyecto_id Int
  autor       String
  fecha       DateTime         @default(now())
  contenido   String
  proyecto    ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
}

model MaterialRequeridoProyecto {
  id            Int              @id @default(autoincrement())
  proyecto_id   Int
  descripcion   String
  tipo          String?
  cantidad      Decimal          @default(1)
  peso_kg       Decimal          @default(0)
  estado        String           @default("Pendiente")
  observaciones String?
  proyecto      ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
}

model PiezaProyecto {
  id                 Int              @id @default(autoincrement())
  proyecto_id        Int
  nombre             String
  cantidad           Int              @default(1)
  avance_fabricacion Float            @default(0)
  requiere_montaje   Boolean          @default(false)
  estado_montaje     String           @default("Pendiente")
  observaciones      String?
  plano_url_1        String?
  plano_url_2        String?
  tipo_material      String?
  largo              Decimal?
  ancho              Decimal?
  espesor            Decimal?
  diametro           Decimal?
  proyecto           ProyectoEspecial @relation(fields: [proyecto_id], references: [id])
  registros          RegistroPieza[]
}

model RegistroPieza {
  id               Int           @id @default(autoincrement())
  pieza_id         Int
  tipo             String
  fecha            DateTime      @default(now())
  descripcion      String
  avance_reportado Float?
  pieza            PiezaProyecto @relation(fields: [pieza_id], references: [id])
}

model Alerta {
  id          Int      @id @default(autoincrement())
  tipo        String
  mensaje     String
  fecha       DateTime @default(now())
  leida       Boolean  @default(false)
  proyecto_id Int?
  maquina_id  Int?
}

model Configuracion {
  id                     Int      @id @default(autoincrement())
  max_proyectos_activos  Int      @default(10)
  nombre_empresa         String?  @default("MI EMPRESA SAS")
  nit_empresa            String?  @default("000.000.000-0")
  direccion_empresa      String?
  telefono_empresa       String?
  email_empresa          String?
  densidad_acero_default Decimal? @default(7.85)
  horas_turno_default    Decimal? @default(8)
  openrouter_api_key     String?
  openrouter_model       String?  @default("google/gemma-3-27b-it:free")
  unidad_longitud        String   @default("mm")
  unidad_peso            String   @default("kg")
  unidad_volumen         String   @default("litros")
  decimales_produccion   Int      @default(2)
  decimales_costos       Int      @default(2)
  decimales_medidas      Int      @default(2)
  umbral_stock_minimo    Decimal  @default(10)
  dias_retraso_alerta    Int      @default(1)
  frecuencia_alertas     String   @default("Inmediata")
  alarma_retraso_ot      Boolean  @default(true)
  alarma_bajo_stock      Boolean  @default(true)
  alarma_mantenimiento   Boolean  @default(true)
  alarma_fases_proyecto  Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model ConfiguracionUsuario {
  id                   Int     @id @default(autoincrement())
  usuario_id           Int     @unique
  tema                 String  @default("Automático")
  color_primario       String  @default("#2563eb")
  color_secundario     String  @default("#475569")
  color_superficie     String  @default("#ffffff")
  color_borde          String  @default("#e2e8f0")
  color_texto          String  @default("#0f172a")
  notificaciones_app   Boolean @default(true)
  notificaciones_email Boolean @default(false)
  usuario              Usuario @relation(fields: [usuario_id], references: [id])
}

model HerramientaConsumible {
  id                  Int                   @id @default(autoincrement())
  codigo              String?               @unique
  nombre              String
  tipo                String
  cantidad_total      Int                   @default(0)
  cantidad_disponible Int                   @default(0)
  estado              String                @default("DISPONIBLE")
  ubicacion           String?
  observaciones       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  prestamos           PrestamoHerramienta[]
}

model PrestamoHerramienta {
  id               Int                   @id @default(autoincrement())
  herramienta_id   Int
  personal_id      Int
  fecha_prestamo   DateTime              @default(now())
  fecha_devolucion DateTime?
  cantidad         Int                   @default(1)
  estado           String                @default("ACTIVO")
  observaciones    String?
  herramienta      HerramientaConsumible @relation(fields: [herramienta_id], references: [id])
  personal         Personal              @relation(fields: [personal_id], references: [id])
}

model Pedido {
  id                     Int            @id @default(autoincrement())
  cliente                String?
  orden_compra           String?
  fecha_emision          DateTime?
  codigo                 String?
  referencia             String?
  posicion               String?
  descripcion            String?
  cantidad               Int?           @default(0)
  cantidad_fabricada     Int?           @default(0)
  cantidad_en_inventario Int?           @default(0)
  cantidad_despachada    Int?           @default(0)
  saldo_pendiente        Int?           @default(0)
  fecha_entrega          String?
  estado                 String?        @default("PENDIENTE")
  precio_unitario        Decimal?       @default(0)
  valor_total            Decimal?       @default(0)
  producto_id            Int?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  ordenes                OrdenTrabajo[]
  producto               Producto?      @relation(fields: [producto_id], references: [id])
}
